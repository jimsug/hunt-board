{
  "name": "hunt-board",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run server/main.ts",
    "dev": "bun --watch run server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && biome check",
    "format": "biome check --write",
    "test": "bun test",
    "check:mongo": "bun run checks/mongo.ts",
    "check:ws": "bun run checks/ws.ts",
    "build:acceptance": "vite build --config vite.acceptance.config.ts --mode development",
    "test:acceptance": "bun run build:acceptance && node tests/acceptance/run.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@xyflow/react": "^12.12.0",
    "bootstrap": "^5.3.8",
    "entities": "^8.0.0",
    "html-to-image": "1.11.11",
    "i18next": "^26.3.6",
    "marked": "^18.0.10",
    "mongodb": "^7.7.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "styled-components": "^6.5.3",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@happy-dom/global-registrator": "^20.14.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.4.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sinon": "^22.0.0",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "chai": "^6.3.0",
    "mocha": "11.8.0",
    "playwright": "1.62.1",
    "sinon": "22.1.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  }
}
